fun partition (pivot, xs) = let
      fun lp (xs, lte, gt) = (case xs
             of [] => (lte, gt)
              | x::xr => if (x <= pivot)
                  then lp (xr, x::lte, gt)
                  else lp (xr, lte, x::gt)
            (* end case *))
      in
        lp (xs, [], [])
      end;

(* NOTE: this is NOT tail recursive! *)
fun append (xs, ys) = (case xs
       of [] => ys
        | x::xr => x :: append(xr, ys)
      (* end case *));

fun qs xs = (case xs
       of [] => []
        | [x] => [x]
        | x::xr => let
            val (lte, gt) = partition (x, xr)
            in
              append (qs lte, x :: qs gt)
            end
      (* end case *));

