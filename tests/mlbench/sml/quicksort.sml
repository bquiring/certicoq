fun sum (xs, n) = case xs of [] => n | x :: r => sum (r, n + x)
fun loop (n, acc) = if n = 0 then acc else
    loop (n - 1, acc + sum (qs unsorted, 0) + sum (qs unsorted', 0) + sum (qs unsorted'', 0))
